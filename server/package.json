{
  "name": "grocery-app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:auth-schema": "tsx src/scripts/create-admin-auth-tables.ts",
    "auth:seed-admin": "tsx src/scripts/seed-admin.ts",
    "auth:grant-admin": "tsx src/scripts/grant-admin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.3.3",
    "firebase-admin": "^13.2.0",
    "ioredis": "^5.6.1",
    "pg": "^8.14.1",
    "razorpay": "^2.9.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.13",
    "drizzle-kit": "^0.30.6",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
